+private fun isBarcodeInsideSerialScanArea(
+    barcode: com.google.mlkit.vision.barcode.common.Barcode,
+    imageWidth: Int,
+    imageHeight: Int
+): Boolean {
+    val box = barcode.boundingBox ?: return false
+    if (imageWidth <= 0 || imageHeight <= 0) return false
+    val centerX = box.exactCenterX() / imageWidth.toFloat()
+    val centerY = box.exactCenterY() / imageHeight.toFloat()
+    val widthFraction = box.width() / imageWidth.toFloat()
+
+    // The visual scan frame is centered. Keep a slightly larger acceptance zone so camera
+    // preview/aspect-ratio differences do not reject valid codes, but reject edge fragments.
+    val centered = centerX in 0.12f..0.88f && centerY in 0.12f..0.88f
+    val isLinear = barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODE_128 ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODE_39 ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODE_93 ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODABAR ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_ITF ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_EAN_13 ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_EAN_8 ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_UPC_A ||
+        barcode.format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_UPC_E
+    return centered && (!isLinear || widthFraction >= 0.14f)
+}
+
+private fun isPlausibleSerialBarcode(value: String, format: Int): Boolean {
+    if (value.length !in 6..96) return false
+    if (value.any { it.isISOControl() }) return false
+    // Serial labels commonly contain letters, digits, underscore, dash, slash and dots.
+    // QR/Data Matrix may contain a larger payload, which normalizeScannedSerial already reduces.
+    if (format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODE_128 ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODE_39 ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODE_93 ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_CODABAR ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_ITF ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_EAN_13 ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_EAN_8 ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_UPC_A ||
+        format == com.google.mlkit.vision.barcode.common.Barcode.FORMAT_UPC_E
+    ) {
+        return value.all { it.isLetterOrDigit() || it == '_' || it == '-' || it == '/' || it == '.' }
+    }
+    return true
+}
